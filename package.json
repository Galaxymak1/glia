{
  "name": "@galaxymak1/glia",
  "version": "0.1.2",
  "description": "Memory for Claude: a personal, self-hosted evidence ledger over your Claude conversations",
  "license": "Elastic-2.0",
  "type": "module",
  "bin": {
    "glia": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "glia": "tsx src/cli.ts",
    "prepack": "npm run build",
    "version": "node scripts/sync-plugin-version.mjs && git add plugin/.claude-plugin/plugin.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Galaxymak1/glia.git"
  },
  "homepage": "https://github.com/Galaxymak1/glia#readme",
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "memory",
    "second-brain",
    "sqlite"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/server": "~2.3.1",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "js-yaml": "^4.3.2",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "~2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "node-llama-cpp": "3.22.2"
  }
}
